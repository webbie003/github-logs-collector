# Security:
# Never include runtime environment files or credentials
# in the Docker build context.
.env
.env.*
secrets/
*.pem
*.key

# Source control.
.git
.gitignore
.github/

# Development / test files.
tests/
examples/

# Python caches.
__pycache__/
*.py[cod]
.pytest_cache/

# Documentation is not required in the runtime image.
README.md
SECURITY.md
LICENSE

# Editor / OS files.
.vscode/
.idea/
.DS_Store

# Runtime data must never be built into the image.
*.log
*.db
*.sqlite
*.sqlite3
*.tmp

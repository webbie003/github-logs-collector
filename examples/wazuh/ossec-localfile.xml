<!--
  GitHub Logs Collector - Wazuh localfile example

  Purpose:
  Instruct Wazuh Logcollector to monitor JSONL events produced by
  github-logs-collector.

  The collector operates independently of Wazuh and can also feed
  other SIEM/log-management platforms.

  Security:
  Mount the github_logs volume read-only into the Wazuh manager
  whenever possible.
-->

<localfile>
  <log_format>json</log_format>
  <location>/var/log/github/events.jsonl</location>
</localfile>

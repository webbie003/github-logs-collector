<!--
  GitHub Logs Collector - Wazuh localfile example

  Both event streams are JSON Lines and are mounted read-only into
  the Wazuh manager through the shared github_logs Docker volume.

  events.jsonl:
    GitHub account, repository, Actions and security telemetry.

  collector.jsonl:
    Collector operational/security health telemetry.
-->

<!-- GitHub activity and security telemetry -->
<localfile>
  <log_format>json</log_format>
  <location>/var/log/github/events.jsonl</location>
</localfile>

<!-- GitHub Logs Collector operational/security telemetry -->
<localfile>
  <log_format>json</log_format>
  <location>/var/log/github/collector.jsonl</location>
</localfile>

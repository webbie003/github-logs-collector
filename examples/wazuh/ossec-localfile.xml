<!--
  GitHub Logs Collector - Wazuh localfile example

  Purpose:
  Instructs Wazuh Logcollector to monitor the JSONL output generated by
  github-logs-collector.

  Security:
  The collector log should be mounted read-only into the Wazuh manager
  whenever possible.
-->

<localfile>
  <log_format>json</log_format>
  <location>/var/log/github/events.jsonl</location>
</localfile>

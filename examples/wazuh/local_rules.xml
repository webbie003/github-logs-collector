<!--
  GitHub Logs Collector - Wazuh rule examples

  These rules demonstrate how events generated by the POLL-mode
  github-logs-collector can be classified by Wazuh.

  Administrators should verify that custom rule IDs do not conflict
  with existing local rules.
-->

<group name="github,github_logs_collector,">

  <!--
    Base GitHub collector event.
  -->
  <rule id="110100" level="3">
    <decoded_as>json</decoded_as>
    <field name="source.type">github</field>
    <description>GitHub Logs Collector event</description>
  </rule>


  <!-- Git push activity -->
  <rule id="110101" level="3">
    <if_sid>110100</if_sid>
    <field name="github.event">PushEvent</field>
    <description>GitHub repository push activity</description>
  </rule>


  <!-- Pull request activity -->
  <rule id="110102" level="3">
    <if_sid>110100</if_sid>
    <field name="github.event">PullRequestEvent</field>
    <description>GitHub pull request activity</description>
  </rule>


  <!-- Repository creation / deletion / branch activity -->
  <rule id="110103" level="4">
    <if_sid>110100</if_sid>
    <field name="github.event">CreateEvent|DeleteEvent</field>
    <description>GitHub repository reference change</description>
  </rule>


  <!-- Dependabot -->
  <rule id="110110" level="7">
    <if_sid>110100</if_sid>
    <field name="source.dataset">security_alert</field>
    <field name="github.event">dependabot</field>
    <description>GitHub Dependabot security alert</description>
  </rule>


  <!-- Code scanning -->
  <rule id="110111" level="8">
    <if_sid>110100</if_sid>
    <field name="source.dataset">security_alert</field>
    <field name="github.event">code_scanning</field>
    <description>GitHub code scanning security alert</description>
  </rule>


  <!-- Secret scanning -->
  <rule id="110112" level="10">
    <if_sid>110100</if_sid>
    <field name="source.dataset">security_alert</field>
    <field name="github.event">secret_scanning</field>
    <description>GitHub secret scanning alert</description>
  </rule>

</group>

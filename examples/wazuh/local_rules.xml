<!--
  GitHub Logs Collector - Wazuh custom rule examples

  These rules demonstrate how events written by github-logs-collector
  can be classified in Wazuh.

  Rule IDs 110100-110199 are used only as an example range.
  Administrators should verify that the IDs do not conflict with their
  existing custom rules before deployment.
-->

<group name="github,github_logs_collector,">

  <!--
    Base rule:
    Identifies any event generated by github-logs-collector.

    Security:
    Low severity because receiving a webhook is not inherently suspicious.
  -->
  <rule id="110100" level="3">
    <decoded_as>json</decoded_as>
    <field name="source.type">github</field>
    <field name="source.transport">webhook</field>
    <description>GitHub webhook event received</description>
  </rule>


  <!-- Git push -->
  <rule id="110101" level="3">
    <if_sid>110100</if_sid>
    <field name="github.event">push</field>
    <description>GitHub repository push event</description>
  </rule>


  <!-- Repository changes -->
  <rule id="110102" level="5">
    <if_sid>110100</if_sid>
    <field name="github.event">repository</field>
    <description>GitHub repository configuration event</description>
  </rule>


  <!-- Repository membership changes -->
  <rule id="110103" level="7">
    <if_sid>110100</if_sid>
    <field name="github.event">member</field>
    <description>GitHub repository membership event</description>
  </rule>


  <!-- Workflow events -->
  <rule id="110104" level="4">
    <if_sid>110100</if_sid>
    <field name="github.event">workflow_run</field>
    <description>GitHub Actions workflow event</description>
  </rule>


  <!-- Secret scanning events -->
  <rule id="110110" level="10">
    <if_sid>110100</if_sid>
    <field name="github.event">secret_scanning_alert</field>
    <description>GitHub secret scanning alert event</description>
  </rule>


  <!-- Code scanning events -->
  <rule id="110111" level="8">
    <if_sid>110100</if_sid>
    <field name="github.event">code_scanning_alert</field>
    <description>GitHub code scanning alert event</description>
  </rule>


  <!-- Dependabot events -->
  <rule id="110112" level="7">
    <if_sid>110100</if_sid>
    <field name="github.event">dependabot_alert</field>
    <description>GitHub Dependabot alert event</description>
  </rule>

</group>

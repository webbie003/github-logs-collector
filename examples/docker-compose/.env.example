# ---------------------------------------------------------------------------
# GitHub Logs Collector - POLL mode
# ---------------------------------------------------------------------------

# Container version.
COLLECTOR_VERSION=0.2.1

# GitHub account whose accessible activity/repositories will be collected.
GITHUB_USERNAME=YOUR_GITHUB_USERNAME

# Security:
# Fine-grained GitHub Personal Access Token.
#
# Grant only the read permissions required by the enabled collectors.
# Never commit the real token to source control.
GITHUB_TOKEN=CHANGE_ME

# Poll interval in seconds.
#
# Note:
# GitHub's Events API is not real-time; polling more frequently does not
# guarantee that GitHub will expose events sooner.
POLL_INTERVAL=300

# HTTP request timeout in seconds.
REQUEST_TIMEOUT=20

# Maximum number of 100-item API pages retrieved per poll cycle.
#
# Security / availability:
# Prevents an unexpectedly large account from causing unbounded API requests.
MAX_PAGES=10

# JSONL event output.
GITHUB_LOG_FILE=/var/log/github/events.jsonl

# Persistent SQLite deduplication/state database.
STATE_DATABASE=/var/lib/github-logs-collector/state.db

# GitHub REST API endpoint.
GITHUB_API_URL=https://api.github.com

# Operational logging verbosity.
LOG_LEVEL=INFO

# Maximum age in seconds of the last successfully completed polling cycle.
#
# The default allows three missed 300-second polling cycles before Docker
# reports the collector as unhealthy.
HEALTH_MAX_AGE=900

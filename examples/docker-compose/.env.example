# GitHub Logs Collector example environment configuration.
# Copy this file to .env before deployment.
#
# Security:
# Never commit the real .env file to source control.
# Container image version to deploy.
COLLECTOR_VERSION=0.1.1
# Interface on which Docker publishes the collector.
#
# Security:
# 127.0.0.1 is the safest default when using a reverse proxy
# on the same host.
#
# Change this to a specific server/LAN address only when direct
# network access to port 8080 is required.
COLLECTOR_BIND_IP=127.0.0.1
# GitHub webhook secret used to authenticate webhook deliveries.
#
# Security:
# Generate a strong random secret with:
# openssl rand -hex 32
#
# Replace CHANGE_ME before deployment.
GITHUB_WEBHOOK_SECRET=CHANGE_ME
# Maximum accepted webhook payload size in bytes.
# Default: 5 MiB.
#
# Security:
# Limits memory/resource consumption from oversized requests.
MAX_CONTENT_LENGTH=5242880

# Application logging verbosity.
# Recommended production value: INFO
LOG_LEVEL=INFO

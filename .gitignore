# Security:
# Never commit real runtime environment files.
.env
.env.*

# Keep documented example environment files.
!.env.example

# Security:
# Never commit local secrets or credentials.
secrets/
*.pem
*.key

# Python.
__pycache__/
*.py[cod]
.pytest_cache/

# Runtime data.
*.log
*.db
*.sqlite
*.sqlite3
*.tmp

# Editors / operating systems.
.vscode/
.idea/
.DS_Store
